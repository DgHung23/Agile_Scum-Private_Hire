{
  "name": "privatehire-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PrivateHire Cars REST API (Express + PostgreSQL)",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node src/migrate.js",
    "seed": "node src/seed.js",
    "seed:demo": "node src/seedDemo.js",
    "db:reset": "node src/migrate.js --reset && node src/seed.js",
    "db:demo": "node src/migrate.js --reset && node src/seedDemo.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
